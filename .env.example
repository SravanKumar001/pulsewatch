# Docker Compose host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# These URLs are used by the browser, so use localhost (not the Compose service name).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/metrics

# Path inside the backend container; the database is stored in the named volume.
DATABASE_URL=sqlite:////app/data/pulsewatch.db
